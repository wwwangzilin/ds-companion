{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-local",
  "description": "本地设置窗口：人设 / 记忆 / 配置的完整读写权限，外加自绘标题栏需要的窗口操作。",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-persona-list",
    "allow-persona-get",
    "allow-persona-save",
    "allow-persona-delete",
    "allow-dsh-preset-scan",
    "allow-dsh-preset-import",
    "allow-config-get",
    "allow-config-set",
    "allow-dsc-get-config",
    "allow-open-settings",
    "allow-memory-list",
    "allow-memory-save",
    "allow-memory-delete",
    "allow-memory-touch",
    "allow-memory-extract",
    "allow-state-get",
    "allow-state-save",
    "allow-state-reset",
    "allow-state-feed",
    "allow-user-state-save",
    "allow-user-state-reset",
    "allow-user-state-get",
    "allow-log-tail",
    "allow-log-clear",
    "allow-log-reveal",
    "allow-data-dir",
    "allow-data-reveal",
    "allow-trash-prune",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-app-quit",
    "allow-window-show-main",
    "allow-settings-take-tab",
    "allow-proposal-list",
    "allow-proposal-accept",
    "allow-proposal-reject",
    "allow-chat-days",
    "allow-chat-read-day",
    "allow-chat-recent",
    "allow-dsc-chat-append",
    "allow-dsc-turn-report",
    "allow-dsc-review-reserve",
    "allow-dsc-review-submit",
    "allow-review-now",
    "allow-dsc-tool-invoke",
    "allow-dsc-tools-brief",
    "allow-dsc-tool-wrap",
    "allow-tools-status",
    "allow-tray-snapshot",
    "allow-daily-digest",
    "allow-tools-set-workspace",
    "allow-tools-set-enabled",
    "allow-tools-log-tail",
    "allow-tools-set-write-enabled",
    "allow-tool-pending-list",
    "allow-dsc-tool-proposal-decide",
    "allow-dsc-diary-days",
    "allow-dsc-diary-read",
    "allow-dsc-avatar-get",
    "allow-dsc-avatar-set",
    "allow-dsc-avatar-clear",
    "allow-dsc-avatar-matrix",
    "allow-dsc-roster-touch"
